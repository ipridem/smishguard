SECRET_KEY=change-me-to-a-random-value
# Postgres for real deployment:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smishing
# SQLite for local/offline use:
DATABASE_URL=sqlite:///smishing.db

# Optional: LLM second opinion for messages the local model can't confidently
# classify (risk 40-60%). Get a free key at https://console.groq.com/keys.
# Leave unset to disable the feature entirely — the app works fine without it.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant
